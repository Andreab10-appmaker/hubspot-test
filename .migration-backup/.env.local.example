# Copia questo file in `.env.local` e inserisci i valori reali (sviluppo locale).
# Su Replit NON usare questo file: imposta le stesse variabili nella tab "Secrets"
# (vedi README.md, sezione "Deploy su Replit").
#
# Servono SOLO le chiavi del/i provider che usi. Il provider di default è OpenAI
# e si può cambiare anche dall'interfaccia (selettore in alto a destra).

# --- OpenAI (provider di default) ---
OPENAI_API_KEY=sk-...
# Modello OpenAI di default se non scelto dall'interfaccia (default app: gpt-5.4-mini)
OPENAI_MODEL=gpt-5.4-mini

# --- Anthropic (opzionale) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- HubSpot (obbligatorio) ---
HUBSPOT_ACCESS_TOKEN=pat-na1-...
